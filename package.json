{
  "name": "rsbuild-plugin-tailwindcss",
  "version": "0.2.4",
  "repository": "https://github.com/rstackjs/rsbuild-plugin-tailwindcss",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "bump": "npx bumpp",
    "dev": "rslib build --watch",
    "lint": "rslint && prettier -c .",
    "lint:write": "rslint --fix && prettier -w .",
    "prepare": "simple-git-hooks && npm run build",
    "test": "playwright test --workers 1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run lint:write"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@rollup/pluginutils": "^5.4.0",
    "@rsbuild/core": "2.2.5",
    "@rslib/core": "^0.23.2",
    "@rslint/core": "^0.9.2",
    "@types/node": "^24.13.4",
    "@types/semver": "^7.8.0",
    "postcss": "^8.5.13",
    "prettier": "^3.9.6",
    "semver": "^7.8.5",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@rsbuild/core": "^1.1.0 || ^2.0.0-0",
    "tailwindcss": "^3.1.0"
  },
  "peerDependenciesMeta": {
    "@rsbuild/core": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.34.5",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  }
}
